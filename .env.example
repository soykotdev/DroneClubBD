# ==============================================================================
# Drone Club Bangladesh — environment variable template
#
# Copy this file to `server/.env` (and fill in real values there) OR to a root
# `.env` consumed by docker-compose. NEVER commit the filled-in file.
#
# SECURITY NOTE: a MongoDB credential was previously shared outside this
# project's version control (in chat/notes). Treat any such credential as
# permanently exposed — rotate it in MongoDB Atlas (Database Access > Edit
# user > Edit password) before use, even in development. Never paste a real
# connection string back into a prompt, doc, commit, or log.
# ==============================================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api

# --- MongoDB -----------------------------------------------------------------
# Use a rotated, least-privileged database user. Never expose this via a
# VITE_ prefixed variable — it must only ever be read by the server process.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER_HOST/droneclub?retryWrites=true&w=majority
MONGODB_DATABASE=droneclub

# --- Auth ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=generate_a_long_random_secret
JWT_REFRESH_SECRET=generate_another_long_random_secret
COOKIE_SECRET=generate_another_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Initial admin (used only by scripts/createAdmin.ts, one time) -----------
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_temporary_password

# --- File storage --------------------------------------------------------
# local: writes to disk — only viable on a persistent server, never on Vercel.
# vercel-blob: use when the API itself runs as a Vercel serverless function.
# s3: any other S3-compatible host.
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=uploads
# Vercel Blob (used when STORAGE_PROVIDER=vercel-blob) — Vercel injects this
# automatically once a Blob store is connected to the project; only set it
# manually for local development against that same store.
BLOB_READ_WRITE_TOKEN=
# S3-compatible (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (optional — leave blank to disable email sending) -----------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Rate limiting / security -------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
